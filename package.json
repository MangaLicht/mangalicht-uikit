{
	"name": "mangalicht-uikit",
	"version": "0.0.6",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"**/*.css",
		"**/*.scss"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./components/*": {
			"types": "./dist/components/*/index.d.ts",
			"import": "./dist/components/*/index.js"
		},
		"./icons": {
			"types": "./dist/icons/index.d.ts",
			"import": "./dist/icons/index.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"import": "./dist/hooks/index.js"
		},
		"./scss/*": "./dist/scss/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"pack": "npm run build && npm pack",
		"pack:clean": "npm run build && npm pack && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"dev": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \".storybook/**/*.{ts,tsx}\"",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"react",
		"ui-kit",
		"typescript",
		"components"
	],
	"license": "MIT",
	"peerDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"lucide-react": "^0.468.0"
	},
	"devDependencies": {
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/react": "^10.5.7",
		"@storybook/react-vite": "^10.5.7",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.5",
		"glob": "^13.0.6",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"sass": "^1.80.6",
		"storybook": "^10.5.7",
		"typescript": "^5.6.3",
		"vite": "^8.2.1",
		"vite-plugin-dts": "^5.0.3",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"prettier": "^3.6.2",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"jsdom": "^26.1.0",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"dompurify": "^3.2.4",
		"marked": "^15.0.6"
	}
}
